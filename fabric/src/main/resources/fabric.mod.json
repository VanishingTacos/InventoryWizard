{
	"schemaVersion": 1,
	"id": "inventorywizard",
	"version": "${version}",
	"name": "InventoryWizard",
	"description": "Magically sort chests, shulker boxes, barrels, ender chests, your inventory and hotbar with cycling sorting modes. Works in singleplayer, as the LAN host, and on servers with the InventoryWizard plugin.",
	"authors": [
		"VanishingTacos"
	],
	"contact": {
		"homepage": "https://github.com/VanishingTacos/InventoryWizard",
		"sources": "https://github.com/VanishingTacos/InventoryWizard"
	},
	"license": "MIT",
	"icon": "assets/inventorywizard/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.inventorywizard.fabric.InventoryWizardFabric"
		],
		"modmenu": [
			"com.inventorywizard.fabric.ModMenuIntegration"
		]
	},
	"mixins": [
		"inventorywizard.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${fabric_loader_min}",
		"minecraft": "${fabric_minecraft_range}",
		"java": ">=${java_version}",
		"fabric-api": "*"
	},
	"suggests": {
		"modsettings": "*"
	}
}
