{
	"schemaVersion": 1,
	"id": "inventorywizard",
	"version": "${version}",
	"name": "InventoryWizard",
	"description": "Magically sort chests, shulker boxes, barrels, ender chests, your inventory and hotbar with cycling sorting modes. Singleplayer (and LAN host) only.",
	"authors": [
		"VanishingTacos"
	],
	"contact": {
		"homepage": "https://github.com/VanishingTacos/InventoryWizard",
		"sources": "https://github.com/VanishingTacos/InventoryWizard"
	},
	"license": "MIT",
	"icon": "assets/inventorywizard/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.inventorywizard.InventoryWizardClient"
		]
	},
	"mixins": [
		"inventorywizard.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
